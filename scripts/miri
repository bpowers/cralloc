#!/usr/bin/env bash
# Run the allocator's unit tests under Miri with strict provenance, as the safety ledger cites,
# each test in a process of its own, several at once, each under a limit of CPU time. On demand,
# not in the gate. Prints one line per test (ok, FAILED, or OVER the limit) and fails if any
# test failed or went over: a test that has grown too slow for Miri is a failure of this check,
# so that nothing drops out of it unnoticed. Tests that cannot run under Miri at all are marked
# `#[cfg_attr(miri, ignore)]` with the reason; tests of the real kernel are not built under Miri.
#
# Usage: scripts/miri [-j JOBS] [FILTER]
#   FILTER  only tests whose path contains it, e.g. `os::sim` or `depot::rules::`
#   -j      tests at once (MIRI_JOBS, default 6); the run's memory cap is shared by all of them
#   MIRI_CPU      the limit of CPU seconds per test, default 600
#   MIRI_MEM      the cap on the whole run, default 12G
#   MIRI_TIMEOUT  the wall-clock limit on the whole run, default 4h
#   MIRI_OUT      where the logs go, default target/miri-check; a failing test's log is kept
#   MIRI_ONLY     a file of test paths, one a line: run only those (to rerun what failed)
# Run it through scripts/heavy. It takes hours, not minutes: about twelve hours of CPU, most of
# it in the few dozen slowest tests (docs/research/miri-check.md has the measurements and what
# makes a test slow under Miri).
#
# Why one process per test: one stuck test would otherwise hold up every test after it without
# saying which, and the limit has to be on CPU time, not wall time, because a measurement pauses
# heavy work for minutes at a time.
#
# The workspace's cargo runner (scripts/run-capped) would take the place of Miri's own runner
# and try to execute Miri's artefacts, so this command puts Miri's runner back; the cap below
# covers the whole run instead.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here/.."

jobs="${MIRI_JOBS:-6}"
while [ $# -gt 0 ]; do
  case "$1" in
    -j) jobs="$2"; shift 2 ;;
    -*) echo "usage: scripts/miri [-j JOBS] [FILTER]" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -le 1 ] || { echo "usage: scripts/miri [-j JOBS] [FILTER]" >&2; exit 2; }

if [ -z "${MIRI_INSIDE_CAP:-}" ]; then
  export MIRI_INSIDE_CAP=1 MIRI_JOBS="$jobs"
  exec "$here/memlimit" -m "${MIRI_MEM:-12G}" -t "${MIRI_TIMEOUT:-4h}" -- "$0" "$@"
fi

filter="${1:-}"
export MIRIFLAGS="${MIRIFLAGS:--Zmiri-strict-provenance}"
# The environment outranks .cargo/config.toml; point it back at Miri's own runner.
CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER="$(rustup which cargo-miri --toolchain nightly) runner"
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER
export MIRI_CPU="${MIRI_CPU:-600}"
out="${MIRI_OUT:-$PWD/target/miri-check}"
rm -rf "$out"
mkdir -p "$out/logs"

list() {
  cargo +nightly miri test -q -p asmalloc --lib -- --list --format terse "$@" |
    sed -n 's/: test$//p' | sort
}
# Building happens here, once; the tests below only run.
list > "$out/all.txt"
list --ignored > "$out/ignored.txt"
comm -23 "$out/all.txt" "$out/ignored.txt" | grep -F -- "$filter" > "$out/tests.txt" || true
if [ -n "${MIRI_ONLY:-}" ]; then
  sort "$MIRI_ONLY" | comm -12 "$out/tests.txt" - > "$out/only.txt"
  mv "$out/only.txt" "$out/tests.txt"
fi
total=$(wc -l < "$out/tests.txt")
[ "$total" -gt 0 ] || { echo "miri: no test matches '$filter'" >&2; exit 2; }
echo "miri: $total tests, $jobs at a time, ${MIRI_CPU} CPU seconds each"

# one TEST: runs it and appends "STATUS SECONDS TEST" to results.txt.
one() {
  local name="$1" log="$out/logs/$1.log" start=$SECONDS status
  # ulimit -t bounds each process's CPU time; the kernel kills Miri with SIGKILL past it.
  (ulimit -t "$MIRI_CPU"; cargo +nightly miri test -q -p asmalloc --lib -- --exact "$name") \
    > "$log" 2>&1
  local code=$?
  # The CPU time of this shell's children, which are the one test's processes: what the limit
  # counts, and what a slow test is judged by, since heavy work is often paused.
  # `times` runs here, not in a command substitution, whose subshell would have no children.
  local cpu
  times > "$log.times"
  cpu=$(tail -1 "$log.times" | awk '{
    split($1, u, /[ms]/); split($2, s, /[ms]/); printf "%d", u[1] * 60 + u[2] + s[1] * 60 + s[2] }')
  rm -f "$log.times"
  if [ $code -eq 0 ] && grep -q "^test result: ok. 1 passed" "$log"; then
    status=ok
    rm -f "$log"
  elif grep -qE "signal: (9|24)," "$log"; then
    status=OVER
  else
    status=FAILED
  fi
  printf '%-6s %5s CPU s %6s s  %s\n' "$status" "$cpu" $((SECONDS - start)) "$name" |
    tee -a "$out/results.txt"
}
export -f one
export out
: > "$out/results.txt"
xargs -a "$out/tests.txt" -d '\n' -P "$jobs" -I{} bash -c 'one "$1"' _ {}

ok=$(grep -c '^ok ' "$out/results.txt" || true)
echo "miri: $ok of $total passed; logs of the rest in $out/logs"
grep -v '^ok ' "$out/results.txt" | sort || true
[ "$ok" -eq "$total" ]
