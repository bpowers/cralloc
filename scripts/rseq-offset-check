#!/usr/bin/env python3
"""Checks that the rseq offset an cralloc binary's routines load shares no page offset with a
slab hot word.

Usage: scripts/rseq-offset-check [--quiet] FILE...   (executables or shared libraries)

The routines load the thread's rseq offset on every call: the executable's copy of glibc's
`__rseq_offset` (R_X86_64_COPY), or a word of their own holding its address (R_X86_64_64) and
then the variable in the dynamic linker. A load whose bytes overlap a hot word in the low 12
bits of its address can wait for the previous call's store to that word, and a loop of
allocations of that class then runs one at a time (docs/research/zen5-roofline.md, section 16).
The routines' words are 16-aligned by construction, so they should never collide; this checks
that the link kept them so. Builds from before 2026-10-19 read a GOT slot (R_X86_64_GLOB_DAT)
instead, which the linker places at any 8-aligned address; for them the slot is checked too.
Prints each place, with its page offset, and exits 1 if one that fast paths load on every call
collides, 0 otherwise; a file with no such relocation (built without cralloc, or statically
linked) passes. Needs `readelf` (binutils).
"""

import re
import subprocess
import sys

# The page offsets of the hot words: bytes 24 to 31 of chunk c of a slab, for every class index c
# (crates/cralloc/src/front/slab.rs; a test there checks that this line agrees).
HOT_WORDS = [32 * c + 24 for c in range(1, 45)]


def collides(addr: int) -> bool:
    at = addr % 4096
    return any(at < w + 8 and w < at + 8 for w in HOT_WORDS)


def readelf(*args: str) -> str:
    return subprocess.run(["readelf", "-W", *args], check=True, capture_output=True, text=True).stdout


def interpreter(path: str) -> str | None:
    m = re.search(r"Requesting program interpreter: ([^\]]+)\]", readelf("-l", path))
    return m.group(1) if m else None


def symbol_value(path: str, name: str) -> int | None:
    for line in readelf("--dyn-syms", path).splitlines():
        f = line.split()
        if len(f) >= 8 and f[7].split("@")[0] == name and f[6] != "UND":
            return int(f[1], 16)
    return None


def places(path: str) -> list[tuple[str, int, bool]]:
    """Each place the routines in `path` load the rseq offset from, as (what, address, whether
    the inlined fast paths load it on every call, so that a collision fails the check)."""
    relocs = []
    for line in readelf("-r", path).splitlines():
        f = line.split()
        if len(f) >= 5 and f[4].split("@")[0] == "__rseq_offset":
            relocs.append((f[2], int(f[0], 16)))
    kinds = {k for k, _ in relocs}
    # The routines' own words: only the routines emit absolute references to the variable. Where
    # they are, the GOT slot serves only Rust code off the fast paths.
    own_words = "R_X86_64_64" in kinds
    found = []
    for kind, addr in relocs:
        if kind == "R_X86_64_64":
            found.append(("a routine's word holding the address of __rseq_offset", addr, True))
        elif kind == "R_X86_64_GLOB_DAT" and own_words:
            continue
        elif kind == "R_X86_64_GLOB_DAT" and "R_X86_64_COPY" in kinds:
            # An older executable with a copy: the inlined routines read the copy, and only the
            # out-of-line ones read through the slot.
            found.append(("the GOT slot of __rseq_offset (out-of-line routines only)", addr, False))
        elif kind == "R_X86_64_GLOB_DAT":
            found.append(("the GOT slot of __rseq_offset", addr, True))
        else:
            found.append((f"{kind} of __rseq_offset", addr, True))
    if (own_words or "R_X86_64_GLOB_DAT" in kinds) and "R_X86_64_COPY" not in kinds:
        # Through the word or the GOT, the second load reads the variable where the C library
        # defines it.
        ld = interpreter(path) or "/lib64/ld-linux-x86-64.so.2"
        value = symbol_value(ld, "__rseq_offset")
        if value is not None:
            found.append((f"__rseq_offset in {ld}", value, True))
    return found


def main() -> int:
    args = sys.argv[1:]
    quiet = "--quiet" in args
    files = [a for a in args if a != "--quiet"]
    if not files:
        print(__doc__, file=sys.stderr)
        return 2
    bad = 0
    for path in files:
        clear_words = 0
        for what, addr, hot in places(path):
            hit = collides(addr)
            bad += hit and hot
            # Every inlined routine has a word of its own: count the clear ones, not list them.
            if what.startswith("a routine's word") and not hit:
                clear_words += 1
                continue
            if hit or not quiet:
                verdict = ("COLLIDES with a hot word" if hot else "shares a hot word's offset") \
                    if hit else "clear"
                print(f"{path}: {what} at page offset {addr % 4096:#05x}: {verdict}")
        if clear_words and not quiet:
            print(f"{path}: {clear_words} routines' words holding the address of __rseq_offset: "
                  "clear")
    if bad:
        print("rseq-offset-check: a routine's every call can wait on the previous call's store "
              "to a hot word; see docs/research/zen5-roofline.md, section 16", file=sys.stderr)
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
