#!/usr/bin/env python3
"""Checks the safety ledger's IDs against the code (CLAUDE.md, "Correctness rules").

An entry is a heading in docs/safety/**/*-safety.md that starts with its ID, such as
`## KERNEL-06: ...`. An ID is upper-case words joined by hyphens and a two-digit number. A
ledger file `docs/safety/<crate>/<path>-safety.md` covers `crates/<crate>/src/<path>.rs`.

Fails if an ID cited in the code under crates/ names no entry, if two entries share an ID, or
if no code cites an entry. Fails too if an `unsafe` block, `unsafe impl`, `unsafe extern`
block or `#[unsafe(...)]` attribute in the code that ships cites neither a ledger entry nor a
Kani harness, or if an `unsafe fn` or `unsafe trait` there has no `# Safety` section: a
declaration is a contract, and the blocks that rely on it are checked one by one
(`unsafe_sites.py` says what ships and how a site's comments are found). Prints, without
failing, the ledger files with no `Reviewed: <commit>` line, and those whose source file has
changed since that commit.

Usage: scripts/ledger-check
"""

import pathlib
import re
import subprocess
import sys

import unsafe_sites

ROOT = pathlib.Path(__file__).resolve().parent.parent
ID = unsafe_sites.ID
HEADING = re.compile(r"^#+\s+(" + ID.pattern + r")", re.M)
REVIEWED = re.compile(r"^Reviewed: ([0-9a-f]{7,40})\b", re.M)


def rel(path: pathlib.Path) -> str:
    return str(path.relative_to(ROOT))


def source_of(ledger: pathlib.Path) -> pathlib.Path:
    crate, *rest = ledger.relative_to(ROOT / "docs/safety").parts
    name = "/".join(rest).removesuffix("-safety.md") + ".rs"
    return ROOT / "crates" / crate / "src" / name


def changed_since(commit: str, source: pathlib.Path) -> bool | None:
    """Whether `source` differs from what it was at `commit` (None: git could not tell)."""
    run = subprocess.run(
        ["git", "-C", str(ROOT), "diff", "--quiet", commit, "--", rel(source)],
        capture_output=True,
    )
    return {0: False, 1: True}.get(run.returncode)


def main() -> int:
    ledgers = sorted((ROOT / "docs/safety").rglob("*-safety.md"))
    defined: dict[str, list[pathlib.Path]] = {}
    for ledger in ledgers:
        for match in HEADING.finditer(ledger.read_text()):
            defined.setdefault(match.group(1), []).append(ledger)

    cited: set[str] = set()
    unknown: list[str] = []
    sources = sorted(p for p in (ROOT / "crates").rglob("*.rs") if "target" not in p.parts)
    for path in sources:
        for number, line in enumerate(path.read_text().splitlines(), 1):
            for match in ID.finditer(line):
                cited.add(match.group(0))
                if match.group(0) not in defined:
                    unknown.append(f"{rel(path)}:{number}: {match.group(0)}")

    unreviewed, stale = [], []
    for ledger in ledgers:
        found = REVIEWED.search(ledger.read_text())
        if not found:
            unreviewed.append(ledger)
            continue
        source = source_of(ledger)
        changed = changed_since(found.group(1), source) if source.exists() else None
        if changed is not False:
            note = "changed" if changed else "cannot compare"
            stale.append(f"{rel(ledger)} ({note}: {rel(source)} since {found.group(1)})")
    if unreviewed:
        print(f"ledger-check: {len(unreviewed)} of {len(ledgers)} ledger files have no "
              "'Reviewed: <commit>' line:")
        for ledger in unreviewed:
            print(f"  {rel(ledger)}")
    if stale:
        print(f"ledger-check: {len(stale)} reviewed ledger files whose code changed since:")
        for line in stale:
            print(f"  {line}")

    failed = 0
    broken = unsafe_sites.self_test()
    if broken:
        print("ledger-check: the scan of unsafe sites fails its own cases:")
        for line in broken:
            print(f"  {line}")
        failed = 1
    wrong = []
    shipping, harnesses = unsafe_sites.sites(ROOT)
    for site in shipping:
        problem = unsafe_sites.verdict(site, harnesses, defined)
        if problem is not None:
            what = site.kind if site.problem else f"unsafe {site.kind}"
            wrong.append(f"{rel(site.path)}:{site.line}: {what}: {problem}")
    if wrong:
        print("ledger-check: shipping code the scan of unsafe sites does not accept:")
        for line in wrong:
            print(f"  {line}")
        failed = 1
    twice = sorted(i for i, files in defined.items() if len(files) > 1)
    if twice:
        print("ledger-check: IDs defined more than once:")
        for i in twice:
            print(f"  {i} ({', '.join(map(rel, defined[i]))})")
        failed = 1
    uncited = sorted(i for i in defined if i not in cited)
    if uncited:
        print("ledger-check: entries no code cites:")
        for i in uncited:
            print(f"  {i} ({', '.join(map(rel, defined[i]))})")
        failed = 1
    if unknown:
        print("ledger-check: cited IDs with no ledger entry:")
        for line in unknown:
            print(f"  {line}")
        failed = 1
    return failed


if __name__ == "__main__":
    sys.exit(main())
