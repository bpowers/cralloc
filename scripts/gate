#!/usr/bin/env bash
# The merge gate: formatting, the generated-code and ledger checks, lints, unit tests and the
# quick Kani proofs. Run it before asking for a merge.
#
# Usage: scripts/gate [--all]
#   --all  also run the ignored tests (the full bounds of the slow explorations and stress
#          runs) and the slow Kani harnesses, each in its own capped scope
#          (scripts/kani-all verify_slow). That takes many minutes; run it on demand.
#
# Never add a slow step to the default run. A test that takes more than about three seconds
# is split into a `_quickly` test and an ignored `_fully` one, with
# `#[ignore = "slow: run with scripts/gate --all"]` (depot/interleave.rs has examples). A Kani
# harness belongs in a `verify.rs` module when it finishes in about a second, and in
# `verify_slow.rs` otherwise. Miri and benchmarks run on demand.
#
# The tests and the proofs run at once. Each test binary runs under the workspace's 4 GiB cap
# (scripts/run-capped), the quick proofs under Kani's 6 GiB one (scripts/kani) and then the slow
# proofs under that one each and 12 GiB between them (scripts/kani-all), so together they stay
# within the machine's 16 GiB limit for one job.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here/.."

all=
case "${1-}" in
  "") ;;
  --all) all=1 ;;
  *) echo "usage: scripts/gate [--all]" >&2; exit 2 ;;
esac

out="$(mktemp -d)"
trap 'rm -rf "$out"' EXIT

# Runs a step in the foreground and prints how long it took.
step() {
  local name="$1" start=$SECONDS
  shift
  "$@"
  printf '== %-16s %4ss\n' "$name" "$((SECONDS - start))"
}

# Starts a step in the background, its output and its status and time kept under $out.
start() {
  local name="$1"
  shift
  (
    begin=$SECONDS
    set +e
    "$@" > "$out/$name.log" 2>&1
    echo "$? $((SECONDS - begin))" > "$out/$name.status"
  ) &
}

# Waits for every background step, reports each, and prints the log of any that failed.
finish() {
  wait
  local failed=0 name status took
  for name in "$@"; do
    read -r status took < "$out/$name.status"
    if [ "$status" -eq 0 ]; then
      printf '== %-16s %4ss\n' "$name" "$took"
      summarize "$name"
    else
      printf '== %-16s %4ss  FAILED (exit %s)\n' "$name" "$took" "$status"
      cat "$out/$name.log"
      failed=1
    fi
  done
  return "$failed"
}

summarize() {
  case "$1" in
    tests)
      awk '/^test result:/ { p += $4; i += $8 } END { printf "   %d passed, %d ignored\n", p, i }' \
        "$out/tests.log" ;;
    proofs) grep -E '^Complete|^kani-all:' "$out/proofs.log" | sed 's/^/   /' || true ;;
    musl) grep -E '^musl: skipped|^test result:' "$out/musl.log" | sed 's/^/   /' || true ;;
  esac
}

tests() {
  if [ -n "$all" ]; then
    # Optimized, with every debug check on (the `gate` profile in Cargo.toml): the explorations
    # are mostly work the optimizer removes. Not the doctests: an ignored doctest is an example
    # that is not meant to run. The limit on a test binary allows for a busy machine: the
    # allocator's takes about ten minutes alone, and an hour with others' work on these cores.
    CRALLOC_TEST_TIMEOUT="${CRALLOC_TEST_TIMEOUT:-2h}" \
      cargo test --workspace --quiet --profile gate --lib --bins --tests -- --include-ignored &&
      cargo test --workspace --quiet --doc
  else
    cargo test --workspace --quiet
  fi
}

proofs() {
  MEMLIMIT_QUIET=1 KANI_TIMEOUT="${KANI_TIMEOUT:-5m}" \
    "$here/kani" -p cralloc --harness ::verify:: --output-format terse || return
  if [ -n "$all" ]; then
    "$here/kani-all" verify_slow
  fi
}

lints() {
  # Not --all-features: some crates have features that need nightly (the testkit's
  # `allocator-api`). The allocator's `sim` feature is linted on its own.
  cargo clippy --workspace --all-targets --quiet -- -D warnings &&
    cargo clippy -p cralloc --all-targets --features sim --quiet -- -D warnings &&
    # The build without the background thread is the one that asks nothing of a C library
    # (CLAUDE.md), and nothing else builds it.
    cargo clippy -p cralloc --all-targets --no-default-features --quiet -- -D warnings
}

# The musl build: the allocator brings and registers its own rseq area there (front/area.rs), and
# the explorers' tasks are OS threads, as they are nowhere else in the gate (turns.rs). Its tests
# build in a few seconds alongside the others. Skipped, saying so, where the target is not installed.
musl() {
  local target
  target="$(uname -m)-unknown-linux-musl"
  if ! rustup target list --installed 2>/dev/null | grep -qx "$target"; then
    echo "musl: skipped: the $target target is not installed (rustup target add $target)"
    return 0
  fi
  cargo clippy -p cralloc --all-targets --target "$target" --quiet -- -D warnings &&
    cargo test -p cralloc --lib --target "$target" --quiet -- front:: turns:: back::explore::
}

step format cargo fmt --all --check
step generated "$here/generated-check"
step ledger "$here/ledger-check"
step lints lints
start tests tests
start proofs proofs
start musl musl
finish tests proofs musl
printf '\ngate: passed in %ss\n' "$SECONDS"
