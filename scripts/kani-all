#!/usr/bin/env bash
# Run every Kani harness in the workspace, each in its own memory-capped scope, and print one
# line per harness with its result and time. Exits non-zero if any failed.
#
# Usage: scripts/kani-all [PATTERN]
#   PATTERN  only harnesses whose full path contains it, e.g. `verify_slow` or `space::`.
#
# Why one scope per harness: a single `cargo kani` runs its harnesses in one cgroup, and CBMC's
# memory use accumulates across them, so a set whose members each fit under the cap can still
# be killed as a whole.
#
# Harnesses are found from their `#[kani::proof]` attributes, so the list never goes stale. The
# convention this relies on: harnesses live in `verify.rs` (quick: the merge gate runs them all
# together, so each must finish in a few seconds) or `verify_slow.rs` (on demand), and the
# module path follows the file path.
set -uo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/.." && pwd)"
cd "$root"
pattern="${1:-}"

# Prints "package<TAB>module::path::harness" for every harness.
list() {
  local file pkg rel module name
  while IFS= read -r file; do
    pkg="${file#crates/}"; pkg="${pkg%%/*}"
    rel="${file#crates/$pkg/src/}"; rel="${rel%.rs}"; rel="${rel%/mod}"
    module="${rel//\//::}"
    grep -A6 '#\[kani::proof\]' "$file" | grep -oE '^\s*(pub(\([a-z]+\))? )?fn [a-z_0-9]+' \
      | sed -E 's/.*fn //' | sort -u | while IFS= read -r name; do
        printf '%s\t%s::%s\n' "$pkg" "$module" "$name"
      done
  done < <(grep -rl '#\[kani::proof\]' crates/*/src --include='*.rs' | sort)
}

mapfile -t harnesses < <(list | grep -F -- "$pattern")
[ "${#harnesses[@]}" -gt 0 ] || { echo "kani-all: no harnesses match '$pattern'" >&2; exit 2; }
failed=0
for entry in "${harnesses[@]}"; do
  pkg="${entry%%$'\t'*}"; harness="${entry#*$'\t'}"
  start=$(date +%s)
  if out=$(MEMLIMIT_QUIET=1 "$here/kani" -p "$pkg" --harness "$harness" --exact \
             --output-format terse 2>&1); then
    status=ok
  else
    status=FAILED; failed=$((failed + 1))
  fi
  printf '%-72s %-6s %5ds\n' "$harness" "$status" "$(( $(date +%s) - start ))"
  if [ "$status" = FAILED ]; then
    printf '%s\n' "$out" | grep -E 'FAILURE|Failed Checks|error|panicked|timed out' | head -5
  fi
done
echo "kani-all: ${#harnesses[@]} harnesses, $failed failed"
[ "$failed" -eq 0 ]
