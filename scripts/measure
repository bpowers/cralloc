#!/usr/bin/env bash
# Run a timed measurement with nothing else measuring, and, for one that uses both L3s,
# with heavy work paused.
#
# Usage: scripts/measure [--both-l3] command args...
#   Measurements run one at a time. With --both-l3 (the job also uses cores of the second
#   L3, whose cache heavy work shares) everything started through scripts/heavy is frozen
#   while the command runs and thawed when it ends, and heavy work that arrives meanwhile
#   waits. Either way, hold it for minutes, not hours: split a long session into pieces.
#   ASMALLOC_LOCK_DIR  where the lock files live, default /tmp.
#
# `benchrun layout` takes the measurement lock itself: run it without this script.
set -euo pipefail

both=0
if [ "${1:-}" = "--both-l3" ]; then
  both=1
  shift
fi
[ $# -gt 0 ] || { echo "usage: scripts/measure [--both-l3] command args..." >&2; exit 2; }
locks="${ASMALLOC_LOCK_DIR:-/tmp}"
slice="asmalloc-heavy.slice"

if grep -q "$slice" /proc/self/cgroup 2>/dev/null; then
  echo "measure: started under scripts/heavy; a measurement cannot pause itself" >&2
  exit 2
fi
unset ASMALLOC_HEAVY_SLICE

exec 7>>"$locks/asmalloc-measure.lock"
flock -x 7
if [ "$both" = 1 ]; then
  # After the measurement lock, so heavy work is held back only while this one runs, not
  # while it queues behind another measurement.
  exec 8>>"$locks/asmalloc-heavy.turn"
  flock -x 8
  trap 'systemctl --user thaw "$slice" 2>/dev/null || true' EXIT
  trap 'exit 130' INT TERM HUP
  # Fails when no heavy work is running, which leaves nothing to pause.
  systemctl --user freeze "$slice" 2>/dev/null || true
fi

status=0
"$@" 7>&- 8>&- || status=$?
exit "$status"
