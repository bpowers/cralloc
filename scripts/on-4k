#!/usr/bin/env bash
# Runs a command on a real kernel with 4 KiB pages, in a microVM on this host's performance cores,
# and returns its output and exit status. A binary built here runs there unchanged, which is the
# test of the page size found at run time. The VM shares the filesystem. Its kernel has no
# transparent huge pages, and may be older than the host's.
#
# muvm does not return the command's output or status, so the command writes them to files that
# this script reads back.
#
# Usage: scripts/heavy scripts/on-4k command args...
#   ON_4K_CPUS  the host's CPUs the VM runs on, default 2-5
#   ON_4K_MEM   the VM's memory in MiB, default 4096, which caps the command as scripts/memlimit
#               would; never above 16384
set -euo pipefail
[ $# -gt 0 ] || { echo "usage: scripts/on-4k command args..." >&2; exit 2; }
mem="${ON_4K_MEM:-4096}"
[ "$mem" -le 16384 ] || { echo "on-4k: ON_4K_MEM above 16384" >&2; exit 2; }

work="$(mktemp -d "${TMPDIR:-/tmp}/on-4k.XXXXXX")"
trap 'rm -rf "$work"' EXIT

{
  echo '#!/usr/bin/env bash'
  # The caller's environment, but for what names this session's bus and display.
  export -p | grep -Ev '^declare -x (DBUS_|DISPLAY=|WAYLAND_|XDG_|SSH_|TERM=|OLDPWD)' || true
  printf 'cd %q\n' "$PWD"
  printf '%q ' "$@"
  printf '> %q 2>&1\n' "$work/out"
  printf 'echo $? > %q\n' "$work/status"
} > "$work/run"
chmod +x "$work/run"

muvm --mem="$mem" -c "${ON_4K_CPUS:-2-5}" -- "$work/run" > "$work/muvm" 2>&1 || true
if [ ! -f "$work/status" ]; then
  echo "on-4k: the command did not finish in the VM; muvm said:" >&2
  cat "$work/muvm" >&2
  exit 125
fi
cat "$work/out"
exit "$(cat "$work/status")"
