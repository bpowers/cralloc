import Cralloc.TCB.Rust
import Cralloc.TCB.Axioms
import Cralloc.Proof.Examples.AArch64.Seq
import Cralloc.Proof.Framework.Registration

/-!
# A sequence with a setup, through the emitter

The example of `Proof/Examples/AArch64/Seq.lean` as an `Artifact`, which the emitter
checks and renders: its setup in place, ahead of the label an abort returns to, the
word after its descriptor, and its abort handler in the function's own section.
`#assert_standard_axioms` audits it here, as it is no registration file's.
-/

namespace VG.Test.SeqAArch64

open VG.Proof.Examples.AArch64.Seq

def api : Api where
  module := "seq"
  name := "vg_seq"
  sig := sig
  contracts := some fun A _ => seqContract A
  summary := "An example."
  safety := ["The thread's rseq area must be registered."]
  operands := [("__rseq_offset", .sym "crate::front::__rseq_offset")]

def art : Artifact := api.artifact VG.AArch64.target {
  setup := setup
  code := code
  attempt := attempt
  verified := verified
  restartsOk := restartsOk
  setupOk := setupOk
  witnesses := witnesses
  witnessOk := witnessOk }

#assert_standard_axioms VG.Test.SeqAArch64.art

/-- The file the emitter writes for it. -/
def file : Option String :=
  match Rust.files [art] with
  | .ok fs => (fs.find? (·.1 == "aarch64/seq.rs")).map (·.2)
  | .error _ => none

#guard file == some "// @generated by lean/Emit.lean. DO NOT EDIT.
//! Verified `seq` functions for `aarch64`.
#![allow(dead_code)]

/// An example.
///
/// # Safety
///
/// * The thread's rseq area must be registered.
#[unsafe(naked)]
pub(crate) unsafe extern \"C\" fn vg_seq(p: usize, v: u64) {
    core::arch::naked_asm!(
        \".cfi_startproc\\nadrp x11, 3f\\nadd x11, x11, :lo12:3f\\nldr x9, [x11, #32]\\nldr x9, [x9]\\nmrs x10, tpidr_el0\\nadd x10, x10, x9\\n5:\\nstr x11, [x10, #8]\\n6:\\nldr w8, [x10, #4]\\ncmp w8, #2, lsl #12\\nb.hs 7f\\nstr x1, [x0]\\n7:\\n.pushsection __rseq_cs, \\\"aw\\\"\\n.balign 32\\n3:\\n.long 0, 0\\n.quad 6b, 7b - 6b, 4f\\n.quad {__rseq_offset}\\n.popsection\\n.subsection 1\\n.inst 0xd428bc00\\n4:\\nb 5b\\n.subsection 0\\nret\\n.cfi_endproc\\n.p2align 6\",
        __rseq_offset = sym crate::front::__rseq_offset,
    )
}
"

end VG.Test.SeqAArch64
