import Asmalloc.TCB.Emit

/-!
# Golden tests for the emitter's driver and arguments

`Emit.driver` writes the program that emits every artifact: these tests pin
down which modules it imports and what it audits.
-/

namespace VG.Test.Emit

open VG.Emit

#guard listOf "Asmalloc.Artifacts.Selftest.X86_64" == "VG.Artifacts.Selftest.X86_64.artifacts"

#guard driver ["Asmalloc.Artifacts.Selftest.X86_64", "Asmalloc.Artifacts.Pop.X86_64"] ==
  "-- Generated by Emit.lean, which runs it. DO NOT EDIT.\n\
  import Asmalloc.TCB.Audit\n\
  import Asmalloc.TCB.Axioms\n\
  import Asmalloc.TCB.Emit\n\
  import Asmalloc.Artifacts.Selftest.X86_64\n\
  import Asmalloc.Artifacts.Pop.X86_64\n\
  \n\
  namespace VG.Emit\n\
  \n\
  def all : List Artifact := List.flatten [VG.Artifacts.Selftest.X86_64.artifacts, \
    VG.Artifacts.Pop.X86_64.artifacts]\n\
  \n\
  #assert_standard_axioms all\n\
  #assert_no_compiler_overrides all run\n\
  #assert_spec_origin\n\
  \n\
  end VG.Emit\n\
  \n\
  def main (args : List String) : IO UInt32 := VG.Emit.run VG.Emit.all args\n"

-- The output directory is `generated` unless one is named; anything else is
-- a usage error.
/-- `parseArgs`, with the directory as a string. -/
def parsed (args : List String) : Option (Bool × String) :=
  (parseArgs args).map fun (c, d) => (c, d.toString)

#guard parsed [] == some (false, "generated")
#guard parsed ["--check"] == some (true, "generated")
#guard parsed ["../crates/asmalloc/src/asm"] == some (false, "../crates/asmalloc/src/asm")
#guard parsed ["--check", "out"] == some (true, "out")
#guard parseArgs ["out", "--check"] == none
#guard parseArgs [""] == none
#guard parseArgs ["--check", ""] == none
#guard parseArgs ["--part", "f"] == none
#guard parseArgs ["a", "b"] == none

end VG.Test.Emit
