diff --git a/bench/alloc/src/shape.rs b/bench/alloc/src/shape.rs
new file mode 100644
index 0000000..9e6187e
--- /dev/null
+++ b/bench/alloc/src/shape.rs
@@ -0,0 +1,120 @@
+//! Diagnostic only (feature `shape`): changes where chosen requests land, to test what a
+//! workload's speed depends on. Wraps asmalloc. Read once from the environment:
+//!
+//! - `SHAPE_BUMP=LO-HI:TO,...`: requests of LO to HI bytes (alignment at most 8) are served as
+//!   TO bytes.
+//! - `SHAPE_SHIFT=SIZE:OFF,...`: a request of exactly SIZE bytes (alignment at most 8) gets a
+//!   block OFF bytes into a block of SIZE + OFF bytes, as a header in front would put it.
+use std::alloc::{GlobalAlloc, Layout};
+use std::sync::atomic::{AtomicUsize, Ordering::*};
+
+static INNER: asmalloc::Asmalloc = asmalloc::Asmalloc;
+
+const MAX: usize = 8;
+static BUMP: [[AtomicUsize; 3]; MAX] = [const { [const { AtomicUsize::new(0) }; 3] }; MAX];
+static SHIFT: [[AtomicUsize; 2]; MAX] = [const { [const { AtomicUsize::new(0) }; 2] }; MAX];
+/// 0 unknown, 1 read
+static STATE: AtomicUsize = AtomicUsize::new(0);
+
+fn parse(name: &std::ffi::CStr, f: impl Fn(usize, &[usize])) {
+    // SAFETY: getenv with a NUL-terminated name; glibc's getenv does not allocate.
+    let v = unsafe { libc::getenv(name.as_ptr()) };
+    if v.is_null() {
+        return;
+    }
+    // SAFETY: getenv returned a NUL-terminated string.
+    let s = unsafe { std::ffi::CStr::from_ptr(v) }.to_bytes();
+    for (i, item) in s.split(|&b| b == b',').enumerate().take(MAX) {
+        let mut nums = [0usize; 3];
+        let mut n = 0;
+        for &b in item {
+            if b.is_ascii_digit() {
+                nums[n] = nums[n] * 10 + (b - b'0') as usize;
+            } else if n < 2 {
+                n += 1;
+            }
+        }
+        f(i, &nums[..=n]);
+    }
+}
+
+#[inline]
+fn ready() {
+    if STATE.load(Relaxed) == 1 {
+        return;
+    }
+    parse(c"SHAPE_BUMP", |i, v| {
+        if v.len() == 3 {
+            BUMP[i][0].store(v[0], Relaxed);
+            BUMP[i][1].store(v[1], Relaxed);
+            BUMP[i][2].store(v[2], Relaxed);
+        }
+    });
+    parse(c"SHAPE_SHIFT", |i, v| {
+        if v.len() == 2 {
+            SHIFT[i][0].store(v[0], Relaxed);
+            SHIFT[i][1].store(v[1], Relaxed);
+        }
+    });
+    STATE.store(1, Relaxed);
+}
+
+/// The layout to ask asmalloc for, and the offset of the block within it.
+#[inline]
+fn shape(l: Layout) -> (Layout, usize) {
+    ready();
+    if l.align() > 8 {
+        return (l, 0);
+    }
+    let s = l.size();
+    for b in &BUMP {
+        let hi = b[1].load(Relaxed);
+        if hi == 0 {
+            break;
+        }
+        if s >= b[0].load(Relaxed) && s <= hi {
+            return (Layout::from_size_align(b[2].load(Relaxed), l.align()).unwrap(), 0);
+        }
+    }
+    for sh in &SHIFT {
+        let size = sh[0].load(Relaxed);
+        if size == 0 {
+            break;
+        }
+        if s == size {
+            let off = sh[1].load(Relaxed);
+            return (Layout::from_size_align(s + off, l.align()).unwrap(), off);
+        }
+    }
+    (l, 0)
+}
+
+pub struct Shape;
+
+// SAFETY: every block handed out lies inside a block asmalloc gave for the layout `shape`
+// returns, and is freed with that same layout and pointer, since `shape` is a function of the
+// caller's layout, which the caller passes back unchanged.
+unsafe impl GlobalAlloc for Shape {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        let (m, off) = shape(l);
+        let p = unsafe { INNER.alloc(m) };
+        if p.is_null() { p } else { unsafe { p.add(off) } }
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        let (m, off) = shape(l);
+        unsafe { INNER.dealloc(p.sub(off), m) }
+    }
+    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+        let (m, off) = shape(l);
+        let p = unsafe { INNER.alloc_zeroed(m) };
+        if p.is_null() { p } else { unsafe { p.add(off) } }
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
+        let n = unsafe { self.alloc(Layout::from_size_align_unchecked(new, l.align())) };
+        if !n.is_null() {
+            unsafe { std::ptr::copy_nonoverlapping(p, n, l.size().min(new)) };
+            unsafe { self.dealloc(p, l) };
+        }
+        n
+    }
+}
diff --git a/bench/alloc/src/trace.rs b/bench/alloc/src/trace.rs
new file mode 100644
index 0000000..44fc64f
--- /dev/null
+++ b/bench/alloc/src/trace.rs
@@ -0,0 +1,163 @@
+//! Diagnostic only (feature `trace`): records every allocation and free, with its layout,
+//! address, CPU and time stamp, into per-thread chunks of a static table, and writes the
+//! table to the file named by `BENCH_ALLOC_TRACE` at exit. Wraps whichever allocator the
+//! other features chose. Never compared: the recording perturbs timing.
+use std::alloc::{GlobalAlloc, Layout};
+use std::cell::Cell;
+use std::sync::atomic::{AtomicPtr, AtomicU64, AtomicUsize, Ordering::*};
+
+#[cfg(feature = "asmalloc")]
+static INNER: asmalloc::Asmalloc = asmalloc::Asmalloc;
+#[cfg(feature = "je")]
+static INNER: tikv_jemallocator::Jemalloc = tikv_jemallocator::Jemalloc;
+#[cfg(not(any(feature = "asmalloc", feature = "je")))]
+static INNER: std::alloc::System = std::alloc::System;
+
+const CHUNK: usize = 1 << 20;
+const CHUNKS: usize = 64;
+
+#[repr(C)]
+struct Rec {
+    tsc: AtomicU64,
+    /// op (0 alloc, 1 free, 2 realloc-new, 3 realloc-old) << 56 | cpu << 40 | align log2 << 32 | size
+    what: AtomicU64,
+    ptr: AtomicU64,
+}
+
+static BASES: [AtomicPtr<Rec>; CHUNKS] = [const { AtomicPtr::new(std::ptr::null_mut()) }; CHUNKS];
+static USED: [AtomicUsize; CHUNKS] = [const { AtomicUsize::new(0) }; CHUNKS];
+static NEXT_CHUNK: AtomicUsize = AtomicUsize::new(0);
+/// 0 unknown, 1 on, 2 off
+static STATE: AtomicUsize = AtomicUsize::new(0);
+
+thread_local! {
+    static MINE: Cell<(usize, usize)> = const { Cell::new((usize::MAX, 0)) };
+}
+
+fn on() -> bool {
+    match STATE.load(Relaxed) {
+        1 => true,
+        2 => false,
+        _ => {
+            // SAFETY: getenv with a NUL-terminated name; glibc's getenv does not allocate.
+            let set = !unsafe { libc::getenv(c"BENCH_ALLOC_TRACE".as_ptr()) }.is_null();
+            if STATE.compare_exchange(0, if set { 1 } else { 2 }, Relaxed, Relaxed).is_ok() && set {
+                // SAFETY: registering a plain extern "C" function.
+                unsafe { libc::atexit(dump) };
+            }
+            STATE.load(Relaxed) == 1
+        }
+    }
+}
+
+#[inline]
+fn record(op: u64, ptr: *mut u8, l: Layout) {
+    if !on() {
+        return;
+    }
+    let _ = MINE.try_with(|m| {
+        let (mut chunk, mut used) = m.get();
+        if chunk == usize::MAX {
+            chunk = NEXT_CHUNK.fetch_add(1, Relaxed);
+            used = 0;
+            if chunk < CHUNKS {
+                // SAFETY: an anonymous private mapping; failure is checked.
+                let p = unsafe {
+                    libc::mmap(
+                        std::ptr::null_mut(),
+                        CHUNK * size_of::<Rec>(),
+                        libc::PROT_READ | libc::PROT_WRITE,
+                        libc::MAP_PRIVATE | libc::MAP_ANONYMOUS,
+                        -1,
+                        0,
+                    )
+                };
+                if p == libc::MAP_FAILED {
+                    chunk = CHUNKS;
+                } else {
+                    BASES[chunk].store(p.cast(), Release);
+                }
+            }
+        }
+        if chunk >= CHUNKS || used >= CHUNK {
+            m.set((chunk, used));
+            return;
+        }
+        // SAFETY: sched_getcpu has no preconditions.
+        let cpu = unsafe { libc::sched_getcpu() } as u64 & 0xffff;
+        // SAFETY: rdtsc has no preconditions.
+        let tsc = unsafe { core::arch::x86_64::_rdtsc() };
+        // SAFETY: used < CHUNK, inside this thread's mapping.
+        let r = unsafe { &*BASES[chunk].load(Relaxed).add(used) };
+        r.tsc.store(tsc, Relaxed);
+        r.what.store(
+            op << 56 | cpu << 40 | (l.align().trailing_zeros() as u64) << 32 | (l.size() as u64 & 0xffff_ffff),
+            Relaxed,
+        );
+        r.ptr.store(ptr as u64, Relaxed);
+        used += 1;
+        USED[chunk].store(used, Relaxed);
+        m.set((chunk, used));
+    });
+}
+
+extern "C" fn dump() {
+    // SAFETY: getenv with a NUL-terminated name.
+    let path = unsafe { libc::getenv(c"BENCH_ALLOC_TRACE".as_ptr()) };
+    if path.is_null() {
+        return;
+    }
+    STATE.store(2, Relaxed);
+    // SAFETY: path is NUL-terminated; the descriptor is written and closed below.
+    let fd = unsafe { libc::open(path, libc::O_WRONLY | libc::O_CREAT | libc::O_TRUNC, 0o644) };
+    if fd < 0 {
+        return;
+    }
+    let chunks = NEXT_CHUNK.load(Relaxed).min(CHUNKS);
+    for c in 0..chunks {
+        let n = USED[c].load(Relaxed);
+        let bytes = n * size_of::<Rec>();
+        let mut off = 0;
+        let base = BASES[c].load(Acquire).cast::<u8>().cast_const();
+        if base.is_null() {
+            continue;
+        }
+        while off < bytes {
+            // SAFETY: the range lies inside the chunk's mapping.
+            let w = unsafe { libc::write(fd, base.add(off).cast(), bytes - off) };
+            if w <= 0 {
+                break;
+            }
+            off += w as usize;
+        }
+    }
+    // SAFETY: fd is ours.
+    unsafe { libc::close(fd) };
+}
+
+pub struct Trace;
+
+// SAFETY: forwards every call unchanged; the recording touches only the table.
+unsafe impl GlobalAlloc for Trace {
+    unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+        let p = unsafe { INNER.alloc(l) };
+        record(0, p, l);
+        p
+    }
+    unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+        record(1, p, l);
+        unsafe { INNER.dealloc(p, l) }
+    }
+    unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+        let p = unsafe { INNER.alloc_zeroed(l) };
+        record(0, p, l);
+        p
+    }
+    unsafe fn realloc(&self, p: *mut u8, l: Layout, new: usize) -> *mut u8 {
+        record(3, p, l);
+        let q = unsafe { INNER.realloc(p, l, new) };
+        // SAFETY: new and the old alignment formed a valid layout for the caller.
+        record(2, q, unsafe { Layout::from_size_align_unchecked(new, l.align()) });
+        q
+    }
+}
