--- a/bench/alloc/src/lib.rs
+++ b/bench/alloc/src/lib.rs
@@ -225,3 +225,21 @@
     // SAFETY: a plain read of an initialized constant that glibc exports.
     unsafe { __rseq_size }
 }
+
+// Diagnostic: BENCH_SIBLINGS, read before main, sets asmalloc's sibling count.
+#[cfg(feature = "asmalloc")]
+#[used]
+#[unsafe(link_section = ".init_array")]
+static BENCH_SIBLINGS_INIT: extern "C" fn() = bench_siblings_init;
+#[cfg(feature = "asmalloc")]
+extern "C" fn bench_siblings_init() {
+    // SAFETY: getenv before any thread exists; the string is read at once.
+    let p = unsafe { libc::getenv(c"BENCH_SIBLINGS".as_ptr()) };
+    if p.is_null() {
+        return;
+    }
+    // SAFETY: a NUL-terminated string from the environment.
+    let s = unsafe { core::ffi::CStr::from_ptr(p) }.to_bytes();
+    let n = s.iter().fold(0usize, |n, &b| n * 10 + (b - b'0') as usize);
+    asmalloc::diag_set_siblings(n);
+}
